enxmlformats-officedocument.spreadsheetml.sheet"}], "folder_structure": {}, "authors": [{"id": 8040380, "full_name": "Zhen Wang", "first_name": "Zhen", "last_name": "Wang", "is_active": true, "url_name": "Zhen_Wang", "orcid_id": ""}, {"id": 8040398, "full_name": "Xiaoyu Wang", "first_name": "Xiaoyu", "last_name": "Wang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 4517044, "full_name": "Shan Cong", "first_name": "Shan", "last_name": "Cong", "is_active": true, "url_name": "Shan_Cong", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://figshare.com/articles/dataset/Towards_Full-colour_Tunability_of_Inorganic_Electrochromic_Devices_Using_Ultracompact_Fabry-Perot_Nanocavities/11154791", "download_disabled": false, "description": "We\nuse the characteristic matrix method derived from the basic principles of\nMaxwell\u2019s equations to model the transmittance/reflectance spectra of the F-P\nnanocavities. <div>The reflection spectra were collected by a UV\u2013vis\nspectrophotometer (V660, JASCO), and the angle-resolved reflection spectra were\ncollected by an angle-resolved spectrum system (R1, ideaoptics, China) equipped\nwith spectrometers (NOVA-EX, ideaoptics, China) over a wavelength range of\n350\u2013850 nm. The electrochemical behaviours were studied by means of cyclic\nvoltammetry (CV) and chronoamperometry (CA), both performed on an\nelectrochemical workstation (CHI 760, CH Instruments, Inc., China) using<a> a conventional three-electrode test cell for the single\nF-P nanocavity electrochromic electrode. A platinum wire and Ag/AgCl saturated\nwith KCl were used as the counter and reference electrode, respectively.</a> A\ntwo-electrode system was used for the performance testing of the fabricated\nelectrochromic devices at room temperature.</div>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 15358836, "created_date": "2019-11-26T04:37:57Z", "modified_date": "2019-11-26T04:39:04Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 2, "name": "CC0", "url": "https://creativecommons.org/publicdomain/zero/1.0/"}, "tags": ["electrochromic applications", "Fabry-Perot resonances", "Inorganic Chemistry"], "keywords": ["electrochromic applications", "Fabry-Perot resonances", "Inorganic Chemistry"], "categories": [{"id": 25138, "title": "Inorganic chemistry not elsewhere classified", "parent_id": 25102, "path": "/25066/25102/25138", "source_id": "340299", "taxonomy_id": 100}], "references": [], "has_linked_file": false, "citation": "Wang, Zhen; Wang, Xiaoyu; Cong, Shan (2019). Towards Full-colour Tunability of Inorganic Electrochromic Devices Using Ultracompact Fabry-Perot Nanocavities. figshare. Dataset. https://doi.org/10.6084/m9.figshare.11154791.v1", "related_materials": [], "is_embargoed": false, "embargo_date": null, "embargo_type": "file", "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 11154791, "title": "Towards Full-colour Tunability of Inorganic Electrochromic Devices Using Ultracompact Fabry-Perot Nanocavities", "doi": "10.6084/m9.figshare.11154791.v1", "handle": "", "url": "https://api.figshare.com/v2/articles/11154791", "published_date": "2019-11-26T04:37:57Z", "thumb": "", "defined_type": 3, "defined_type_name": "dataset", "group_id": null, "url_private_api": "https://api.figshare.com/v2/account/articles/11154791", "url_public_api": "https://api.figshare.com/v2/articles/11154791", "url_private_html": "https://figshare.com/account/articles/11154791", "url_public_html": "https://figshare.com/articles/dataset/Towards_Full-colour_Tunability_of_Inorganic_Electrochromic_Devices_Using_Ultracompact_Fabry-Perot_Nanocavities/11154791", "timeline": {"posted": "2019-11-26T04:37:57", "firstOnline": "2019-11-26"}, "resource_title": null, "resource_doi": null}